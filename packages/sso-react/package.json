{
  "name": "@rjyspl/phoenix-sso-react",
  "version": "0.1.2",
  "description": "React SDK for Yukthi Single Sign-On — provider, hooks, and components to add SSO to any app without hand-rolling the popup/postMessage handshake.",
  "license": "GPL-3.0-only",
  "author": "Yukthi Systems Private Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukthi-Systems/Phoenix-SSO-WebUI.git",
    "directory": "packages/sso-react"
  },
  "bugs": {
    "url": "https://github.com/Yukthi-Systems/Phoenix-SSO-WebUI/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "sso",
    "authentication",
    "react",
    "yukthi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
